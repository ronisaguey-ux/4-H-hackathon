# CornShield AI - Environment Configuration
# Copy this file to .env to set your API keys locally.
# If no key is set, the application will automatically fall back to its
# deterministic Computer Vision diagnostic engine for 100% offline functionality.

# OpenRouter API Key for Multimodal Vision Inference (e.g., google/gemini-3.8-flash)
OPENROUTER_API_KEY=

# Or direct Google Gemini API Key
GEMINI_API_KEY=

# Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False
